  "methods": [
   "progressive long-context pretraining (5 stages: 4K, 32K, 65536, 131072, 262144 tokens)",
   "RoPE base frequency adjustment (10,000 -> 10,000,000)",
   "long data synthesis (fill-in-the-middle, keyword/position-based retrieval, paragraph reordering)",
   "two-stage long-context supervised fine-tuning (short sequences up to 32K, then mixed short/long up to 262K)",
   "offline reinforcement learning on short (<=8K token) samples",
   "custom sparse-attention (dual chunk attention) inference-time length extrapolation for deployment"
  ],
  "objective": "Extend Qwen2.5-7B(-Instruct) from a 128K-token context window to a ~1M-token context window while preserving short-context instruction-following quality, using progressive pretraining, synthesized long-context data, staged SFT and RL.",
